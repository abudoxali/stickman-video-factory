{
  "name": "stickman-video-factory",
  "version": "1.0.0",
  "description": "Code-driven 2D cartoon / stickman animation studio built on Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "pixi.js": "^8.22.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio --no-open",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "qa": "tsx scripts/qa-motion.ts",
    "qa:all": "tsx scripts/scene-cli.ts qa-all",
    "scene:list": "tsx scripts/scene-cli.ts list",
    "scene:validate": "tsx scripts/scene-cli.ts validate",
    "scene:new": "tsx scripts/scene-cli.ts new",
    "scene:preview": "tsx scripts/scene-cli.ts preview",
    "scene:render": "tsx scripts/scene-cli.ts render",
    "scene:verify": "tsx scripts/scene-cli.ts verify",
    "bench": "tsx scripts/bench-motion.ts",
    "probe": "tsx scripts/probe.ts",
    "assets": "node scripts/build-asset-manifest.mjs",
    "render": "node scripts/render-final.mjs Bonk out/bonk.mp4",
    "render:surprise": "node scripts/render-final.mjs TheSurprise out/the-surprise.mp4",
    "render:preview": "remotion render Bonk out/qa/bonk-low.mp4 --scale=0.25",
    "render:preview:surprise": "remotion render TheSurprise out/qa/low.mp4 --scale=0.25",
    "sheets": "node scripts/contact-sheet.mjs out/qa/bonk-low.mp4 out/qa/sheets 6",
    "verify": "node scripts/verify-render.mjs out/bonk.mp4 --frames 570 --scene bonk",
    "verify:surprise": "node scripts/verify-render.mjs out/the-surprise.mp4 --frames 720",
    "render:show-off": "tsx scripts/scene-cli.ts render show-off out/show-off-final.mp4",
    "verify:show-off": "tsx scripts/scene-cli.ts verify show-off out/show-off-final.mp4",
    "godot:render": "node scripts/godot-render.mjs",
    "render:godot-bridge": "remotion render GodotBridge out/godot-bridge.mp4",
    "blender:render": "node scripts/blender-render.mjs",
    "blender:clip:export": "node scripts/blender-clips.mjs",
    "blender:clip:rebuild": "node scripts/blender-clips.mjs --author",
    "godot:editor": "godot --editor --path godot/cutout-lab",
    "bench:engines": "node scripts/bench-engines.mjs"
  }
}
